# Copie para .env e preencha. O .env nunca entra no Git.

# ---- Banco de dados ----
POSTGRES_DB=nutri
POSTGRES_USER=nutri
# Use apenas letras e numeros (a senha entra em uma URL de conexao).
POSTGRES_PASSWORD=
# Portas publicadas somente em 127.0.0.1
POSTGRES_PORTA=5432
APP_PORTA=3000

# ---- Sessao ----
# Segredo que assina o cookie de login (minimo 32 caracteres): openssl rand -hex 32
SESSAO_SEGREDO=
# true quando o site e servido por HTTPS (VPS); false no Docker Desktop.
SESSAO_COOKIE_SEGURO=false
# Endereco publico do site, usado nos links enviados por e-mail. Ex.: https://meudominio.com.br
APP_URL=

# ---- Notificacoes push ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu@email.com

# ---- Agendador ----
# Minimo 32 caracteres: openssl rand -hex 32
CRON_SECRET=

# ---- Devolutivas com IA ----
OPENAI_API_KEY=

# ---- Cadastro especial ----
CADASTRO_ESPECIAL_INICIO=

# ---- E-mail (redefinicao de senha) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_SENHA=
SMTP_REMETENTE=

# ---- Deploy na VPS (deploy.sh) ----
# Dominio de producao e, se houver, de teste: identificam o ambiente pelo certificado.
DOMINIO_PRODUCAO=
DOMINIO_TESTE=
