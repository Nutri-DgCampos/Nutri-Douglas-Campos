# nginx do HOST da VPS: recebe o HTTPS e repassa para o container nutri-app.
#
# Modelo. Para usar: copie para deploy/nginx/<dominio> (mesmo nome do DOMINIO_PRODUCAO
# ou DOMINIO_TESTE do .env), troque SEU_DOMINIO e siga deploy/nginx/README.md.

server {
    server_name SEU_DOMINIO;

    # Dietas em PDF chegam a 50 MB; a folga cobre o cabecalho da requisicao.
    client_max_body_size 55m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # O app usa estes cabecalhos para saber o endereco publico (links de
        # e-mail) e para recusar requisicoes vindas de outros sites.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # A devolutiva gerada por IA pode levar dezenas de segundos.
        proxy_read_timeout 120s;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/SEU_DOMINIO/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/SEU_DOMINIO/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = SEU_DOMINIO) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name SEU_DOMINIO;
    return 404; # managed by Certbot
}
